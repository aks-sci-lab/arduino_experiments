{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "aks-sci-lab",
    "public": ".",
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.py",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0" }
        ]
      },
      {
        "source": "**/*.wasm",
        "headers": [
          { "key": "Content-Type", "value": "application/wasm" },
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/.*/**",
      ".voc-build/**",
      "**/node_modules/**",
      "app.py",
      "run.bat",
      "run.command",
      "README.md",
      "tests/**",
      "tools/**",
      "teacher-desk/**",
      "vendor/**/*.c",
      "vendor/**/*.h",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.txt"
    ]
  }
}
