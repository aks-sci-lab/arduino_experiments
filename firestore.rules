rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User roles helper function
    function isTeacher(request) {
      return request.auth.token.email == "lany0665@gmail.com" ||
             (exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.isTeacher == true);
    }

    // Experiments collection
    match /experiments/{docId} {
      // Create: user must be authenticated, owner of the data, valid fields
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.keys().hasAll(['userId', 'userEmail', 'timestamp', 'tab', 'weatherSample', 'stargazingSample']) &&
                    request.resource.data.stargazingSample is list &&
                    request.resource.data.stargazingSample.size() <= 14;

      // Read / Update / Delete: owner OR teacher
      allow read, update, delete: if request.auth != null &&
                                     (resource.data.userId == request.auth.uid || isTeacher(request));
    }

    // 걷기·뛰기 판정기 AI 설정 (Gemini 모델·API 키)
    // 읽기: 로그인한 사용자 중 교사, 또는 교사가 학생 사용을 허용(allowStudents)한 경우. 쓰기: 교사만.
    match /appConfig/{docId} {
      allow read: if request.auth != null &&
                     (isTeacher(request) || resource.data.allowStudents == true);
      allow write: if request.auth != null && isTeacher(request);
    }

    // Roles collection (read-only for clients, managed by Admin SDK)
    match /roles/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
