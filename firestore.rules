rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User roles helper function
    function isTeacher(request) {
      return request.auth.token.email == "lany0665@gmail.com" ||
             (exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.isTeacher == true);
    }

    // Experiments collection
    match /experiments/{docId} {
      // Create: user must be authenticated, owner of the data, valid fields
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.keys().hasAll(['userId', 'userEmail', 'timestamp', 'tab', 'weatherSample', 'stargazingSample']) &&
                    request.resource.data.stargazingSample is list &&
                    request.resource.data.stargazingSample.size() <= 14;

      // Read / Update / Delete: owner OR teacher
      allow read, update, delete: if request.auth != null &&
                                     (resource.data.userId == request.auth.uid || isTeacher(request));
    }

    // 걷기·뛰기 판정기 AI 설정 (Gemini 모델·API 키)
    // 읽기: 로그인한 사용자 중 교사, 또는 교사가 학생 사용을 허용(allowStudents)한 경우. 쓰기: 교사만.
    match /appConfig/{docId} {
      allow read: if request.auth != null &&
                     (isTeacher(request) || resource.data.allowStudents == true);
      allow write: if request.auth != null && isTeacher(request);
    }

    // 걷기·뛰기 판정기 학습 데이터: 로그인한 사용자만 읽고, 본인 이름으로만 올리며, 본인 또는 교사만 삭제.
    // 라벨은 학생이 만든 이름도 허용(1~10자). 교사만 evalSet(평가용 지정) 값을 바꿀 수 있다.
    match /walkRunData/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.label is string &&
                    request.resource.data.label.size() >= 1 &&
                    request.resource.data.label.size() <= 10 &&
                    request.resource.data.m is list &&
                    request.resource.data.m.size() >= 200 &&
                    request.resource.data.m.size() <= 6000 &&
                    request.resource.data.evalSet == false;
      allow update: if request.auth != null && isTeacher(request) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evalSet']);
      allow delete: if request.auth != null &&
                    (resource.data.userId == request.auth.uid || isTeacher(request));
    }

    // 조별 모델: 학생 한 명당 문서 하나(문서 id = 본인 uid). 로그인한 사용자 읽기, 본인만 쓰기, 본인 또는 교사 삭제.
    match /walkRunGroupModels/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
                            request.resource.data.json is string &&
                            request.resource.data.json.size() < 900000 &&
                            request.resource.data.group is string &&
                            request.resource.data.group.size() >= 1 &&
                            request.resource.data.group.size() <= 12;
      allow delete: if request.auth != null && (request.auth.uid == uid || isTeacher(request));
    }

    // 교사가 게시하는 반 공용 모델: 로그인한 사용자 읽기, 교사만 쓰기
    match /walkRunModel/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isTeacher(request);
    }

    // 화면 편집 내용(문구·숨김·순서): 누구나 읽고(민감 정보 없음), 교사만 저장
    match /walkRunLayout/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isTeacher(request) &&
                   request.resource.data.json is string &&
                   request.resource.data.json.size() < 200000;
    }

    // 선생님이 만든 실험 설정 (projects/custom-lab.html)
    // 읽기: 공개(published)된 것은 누구나(로그인 전 메인 목록에도 보임, 민감 정보 없음), 숨긴 것은 교사만.
    // 쓰기: 교사만. 제목·안내·열 수 한도를 확인한다. 학생 제출은 위 experiments 에 저장된다.
    match /customExperiments/{docId} {
      allow read: if resource.data.published == true ||
                     (request.auth != null && isTeacher(request));
      allow create, update: if request.auth != null && isTeacher(request) &&
                            request.resource.data.title is string &&
                            request.resource.data.title.size() >= 1 &&
                            request.resource.data.title.size() <= 80 &&
                            request.resource.data.description is string &&
                            request.resource.data.description.size() <= 5000 &&
                            request.resource.data.columns is list &&
                            request.resource.data.columns.size() >= 1 &&
                            request.resource.data.columns.size() <= 8 &&
                            request.resource.data.questions is list &&
                            request.resource.data.questions.size() <= 5 &&
                            request.resource.data.published is bool;
      allow delete: if request.auth != null && isTeacher(request);
    }

    // 스마트폰 진자: 선생님마다 자기 Apps Script 웹 앱(스크립트 ID)을 자기 계정에 저장 (projects/pendulum-setup.html)
    // 본인만 읽고 쓴다. 학생 화면은 이 문서를 읽지 않는다(링크의 ?s= 로 시트를 고름).
    match /pendulumTeachers/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
                            request.resource.data.keys().hasOnly(['scriptId', 'updatedAt']) &&
                            request.resource.data.scriptId is string &&
                            request.resource.data.scriptId.matches('^[A-Za-z0-9_-]{20,120}$') &&
                            request.resource.data.updatedAt == request.time;
    }

    // ===== 수업 연결·조 공유·폰→노트북 (2026-11-18, Apps Script 대신, js/lab-store.js) =====
    // 학생: 화면에 안 보이는 익명 로그인. 이름·학번 없음. 교사: 구글 로그인(수업 주인 = uid).
    // 공간: c…24자(수업), p…24자(노트북↔폰 짝), g<조 코드>(조 코드만 넣어 쓸 때). 공간 id 를 아는 기기만 읽고 쓴다(목록 조회 불가).
    // 모든 문서에 expireAt(만든 때 + 183일): TTL 정책·정리 작업이 지운다. 200일 넘게 늦출 수 없다.
    function signedIn() { return request.auth != null; }
    function isGoogle() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function okSpace(s) { return s.matches('^([cp][a-z0-9]{23}|g[0-9]{1,2}-[0-9]{1,2}-[0-9]{4})$'); }
    function okExpire(d) { return d.expireAt is timestamp && d.expireAt > request.time && d.expireAt < request.time + duration.value(200, 'd'); }
    function shortStr(v, n) { return v is string && v.size() <= n; }
    function okItem(d) {
      return d.exp is string && d.exp.matches('^([a-z]{1,20}|custom:[A-Za-z0-9_-]{1,40})$') &&
             d.group is string && d.group.matches('^[0-9]{1,2}-[0-9]{1,2}-[0-9]{4}$') &&
             d.id is string && d.id.matches('^[A-Za-z0-9_-]{6,40}$') &&
             (!('device' in d) || shortStr(d.device, 20)) &&
             (!('data' in d) || shortStr(d.data, 270000)) &&
             (!('title' in d) || shortStr(d.title, 60)) &&
             (!('summary' in d) || (d.summary is map && d.summary.size() <= 20)) &&
             (!('ivData' in d) || shortStr(d.ivData, 45000)) &&
             (!('glowData' in d) || shortStr(d.glowData, 45000)) &&
             d.keys().size() <= 40 && okExpire(d);
    }
    // 학생에게 열 단계 수: 1 = 첫 단계만 … 99 = 모두 (없으면 예전 수업 = 모두 열림)
    function okStage(d) { return !('stage' in d) || (d.stage is int && d.stage >= 1 && d.stage <= 99); }
    // 🎬 발표 보기 설명 장 상태 (주인 교사만 씀, js/lab-store.js classLesson): 학생 화면이 '👀 앞을 봐요' 띠·답 가리기에 씀
    //  바뀐 칸만 검사 (예전 lesson.at 은 그때 시각이라, 단계 열기·수업 마치기처럼 lesson 을 안 건드리는 쓰기를 막지 않게)
    function okLesson(d, changed) {
      return (!changed.hasAny(['lesson']) || (d.lesson is map && d.lesson.keys().hasOnly(['on', 'stage', 'i', 'key', 'reveal', 'at']) &&
               d.lesson.on is bool && d.lesson.reveal is bool && d.lesson.i is int && d.lesson.i >= 0 && d.lesson.i < 200 &&
               d.lesson.stage is string && d.lesson.stage.size() <= 20 && d.lesson.key is string && d.lesson.key.size() <= 40 && d.lesson.at == request.time)) &&
             // lessonOpen: 목록·200개까지 (원소 모양 ^[a-z0-9][a-z0-9-]{0,39}$ 은 js/lab-store.js classLesson 이 거름 — 규칙에서는 목록 원소를 하나씩 볼 수 없음)
             (!changed.hasAny(['lessonOpen']) || (d.lessonOpen is list && d.lessonOpen.size() <= 200));
    }
    function classOwner(space) { return get(/databases/$(database)/documents/labClasses/$(space)).data.owner; }
    // 팀 이름 수업(필름통 로켓, mode 'team'): 이 실험의 줄은 그 팀 자리(teams/{조 번호})를 잡은 폰(익명 uid)만 만들고 고친다
    function teamUid(space, group) { return get(/databases/$(database)/documents/labClasses/$(space)/teams/$(group.split('-')[1])).data.uid; }
    function okTeamItem(space, d) {
      return d.exp != 'rocket' || (space.matches('^c[a-z0-9]{23}$') && d.uid == request.auth.uid && teamUid(space, d.group) == request.auth.uid &&
             (resource == null || resource.data.uid == request.auth.uid));
    }

    match /labSpaces/{space}/items/{doc} {
      allow get, list: if signedIn() && okSpace(space);
      allow create, update: if signedIn() && okSpace(space) && okItem(request.resource.data) &&
                            doc.size() <= 120 && okTeamItem(space, request.resource.data);
      allow delete: if signedIn() && space.matches('^c[a-z0-9]{23}$') && classOwner(space) == request.auth.uid;
    }
    match /labSpaces/{space}/raw/{doc} {
      allow get: if signedIn() && okSpace(space);
      allow list: if signedIn() && space.matches('^c[a-z0-9]{23}$') && classOwner(space) == request.auth.uid;
      allow create, update: if signedIn() && okSpace(space) && request.resource.data.raw is list &&
                            request.resource.data.raw.size() <= 6 && request.resource.data.keys().hasOnly(['group', 'id', 'raw', 'expireAt']) &&
                            okExpire(request.resource.data);
      allow delete: if signedIn() && space.matches('^c[a-z0-9]{23}$') && classOwner(space) == request.auth.uid;
    }
    // 수업: 공간 id 를 아는 사람(학생 QR)은 읽기, 목록은 주인 것만, 만들기·지우기는 구글 로그인한 주인
    match /labClasses/{space} {
      allow get: if signedIn() && space.matches('^c[a-z0-9]{23}$');
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if isGoogle() && space.matches('^c[a-z0-9]{23}$') && request.resource.data.owner == request.auth.uid &&
                    request.resource.data.keys().hasOnly(['owner', 'classCode', 'ban', 'nStudents', 'groupSize', 'exp', 'groups', 'aiLimit', 'mode', 'setup', 'stage', 'flow', 'createdAt', 'expireAt']) &&
                    okStage(request.resource.data) &&
                    // 진행 방법: 7단계('report' 또는 칸 없음) / 가설연역('hd'). 만든 뒤에는 바꿀 수 없음(아래 update 허용 칸에 없음)
                    (!('flow' in request.resource.data) || request.resource.data.flow in ['report', 'hd']) &&
                    (!('mode' in request.resource.data) || request.resource.data.mode == 'team') &&
                    (!('setup' in request.resource.data) || (request.resource.data.setup is map && request.resource.data.setup.size() <= 24)) &&
                    (!('aiLimit' in request.resource.data) || (request.resource.data.aiLimit is int && request.resource.data.aiLimit >= 0 && request.resource.data.aiLimit <= 200)) &&
                    request.resource.data.classCode is string && request.resource.data.classCode.matches('^[0-9]{1,2}-[0-9]{4}$') &&
                    request.resource.data.groups is list && request.resource.data.groups.size() <= 60 && okExpire(request.resource.data);
      // 주인 교사: 행사 설정(예비 실험 값·목표)·학생에게 열 단계(stage)·'수업 마침' 표시(done·doneAt)·발표 보기 설명 장(lesson·lessonOpen)만 고칠 수 있음
      allow update: if isGoogle() && resource.data.owner == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['setup', 'stage', 'done', 'doneAt', 'lesson', 'lessonOpen']) &&
                    okLesson(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()) &&
                    (!('done' in request.resource.data) || request.resource.data.done is bool) &&
                    // doneAt 도 바뀔 때만 검사 (예전 값은 그때 시각 — 수업을 마친 뒤 설정·단계를 고치는 쓰기를 막지 않게)
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['doneAt']) || request.resource.data.doneAt == null || request.resource.data.doneAt == request.time) &&
                    (!('setup' in request.resource.data) || (request.resource.data.setup is map && request.resource.data.setup.size() <= 24)) &&
                    okStage(request.resource.data);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
    // 팀 이름으로 입장: 팀 하나 = 조 자리 하나. 공간 id 를 아는 가족(익명)은 팀 이름을 보고(같은 이름 막기), 빈 자리만 자기 uid 로 잡음.
    // 잡은 자리는 고칠 수 없음(다른 가족이 덮어쓰지 못하게). 지우기는 수업 주인 교사만
    match /labClasses/{space}/teams/{jo} {
      allow get, list: if signedIn() && exists(/databases/$(database)/documents/labClasses/$(space));
      allow create: if signedIn() && jo.matches('^[0-9]{1,2}$') &&
                    get(/databases/$(database)/documents/labClasses/$(space)).data.mode == 'team' &&
                    int(jo) >= 1 && int(jo) <= get(/databases/$(database)/documents/labClasses/$(space)).data.groups.size() &&
                    request.resource.data.keys().hasOnly(['name', 'key', 'uid', 'device', 'createdAt', 'expireAt']) &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24 &&
                    shortStr(request.resource.data.key, 24) && shortStr(request.resource.data.device, 20) &&
                    request.resource.data.createdAt == request.time && okExpire(request.resource.data);
      allow update: if false;
      allow delete: if isOwner(space);
    }
    // 학생 진행(하트비트): 수업이 있을 때 누구나(익명 학생) 쓰기, 읽기는 수업 주인만
    // 학생 자리 진행 신호: '조-번호'(노트북·수업 QR 로 연 기기), '조-번호-p'(그 자리의 📱 폰 측정 화면, 2026-11-21 따로 둠).
    // uid = 쓴 기기(있으면 자기 uid 만). 지우기는 수업 주인, 또는 그 문서를 마지막에 쓴 기기 자신(조·번호를 바꿀 때 옛 자리 치우기)만
    match /labClasses/{space}/progress/{pid} {
      allow read: if signedIn() && classOwner(space) == request.auth.uid;
      allow create, update: if signedIn() && pid.matches('^[0-9]{1,2}-[0-9]{1,2}(-p)?$') &&
                            exists(/databases/$(database)/documents/labClasses/$(space)) &&
                            request.resource.data.keys().hasOnly(['jo', 'num', 'group', 'step', 'points', 'submitted', 'device', 'lastSeen', 'expireAt', 'uid']) &&
                            (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
                            shortStr(request.resource.data.step, 20) && shortStr(request.resource.data.device, 20) &&
                            request.resource.data.lastSeen == request.time && okExpire(request.resource.data);
      allow delete: if signedIn() && (classOwner(space) == request.auth.uid ||
                       (('uid' in resource.data) && resource.data.uid == request.auth.uid));
    }
    // ----- 보고서 AI 피드백 (2026-11-19, js/report-ai.js) -----
    // 학생(익명)이 질문을 만들면, 켜 둔 교사 화면이 선생님 키로 AI 를 불러 답을 씀. API 키는 교사 브라우저에만 있고 여기엔 오지 않음.
    // 학생은 자기(이 기기 uid) 질문·보고서만 읽음 → 다른 조 것은 못 읽음. 수업 주인 교사만 모두 읽고 답을 씀. 한도는 교사 화면이 셈(규칙은 크기·필드만).
    function isOwner(space) { return signedIn() && classOwner(space) == request.auth.uid; }
    function okAsk(d) {
      return d.keys().hasOnly(['uid', 'group', 'jo', 'exp', 'section', 'sectionName', 'prompt', 'attach', 'draft', 'calc', 'device', 'status', 'createdAt', 'expireAt']) &&
             d.uid == request.auth.uid && d.status == 'wait' && d.createdAt == request.time &&
             d.group is string && d.group.matches('^[0-9]{1,2}-[0-9]{1,2}-[0-9]{4}$') && d.jo is int &&
             d.section is string && d.section.matches('^[a-z0-9_-]{1,20}$') && shortStr(d.sectionName, 40) && shortStr(d.exp, 60) &&
             d.prompt is string && d.prompt.size() >= 1 && d.prompt.size() <= 1500 &&
             d.attach is list && d.attach.size() <= 2 && shortStr(d.draft, 6000) && shortStr(d.calc, 4000) && shortStr(d.device, 20) && okExpire(d);
    }
    match /labClasses/{space}/aiAsk/{id} {
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || classOwner(space) == request.auth.uid);
      allow create: if signedIn() && id.matches('^a[a-z0-9]{19}$') && exists(/databases/$(database)/documents/labClasses/$(space)) && okAsk(request.resource.data);
      allow update: if signedIn() && (
        // 학생: 검증·수정 메모만
        (resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verify']) && shortStr(request.resource.data.verify, 2000)) ||
        // 교사(수업 주인): 답 칸만. '답하는 중'으로 잡기는 기다리는 질문(또는 3분 넘게 멈춘 것)만 → 교사 화면 두 개가 같은 질문을 두 번 부르지 않음
        (classOwner(space) == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'busyAt', 'answer', 'error', 'provider', 'model', 'answeredAt', 'used', 'limit']) &&
         request.resource.data.status in ['wait', 'busy', 'done', 'error', 'limit'] &&
         (request.resource.data.status != 'busy' || resource.data.status == 'wait' || resource.data.busyAt < request.time - duration.value(3, 'm')) &&
         (!('answer' in request.resource.data) || shortStr(request.resource.data.answer, 8000)) &&
         (!('error' in request.resource.data) || shortStr(request.resource.data.error, 300))));
      allow delete: if isOwner(space);
    }
    function okReport(d, rid) {
      return d.keys().hasOnly(['uid', 'group', 'jo', 'exp', 'device', 'sections', 'external', 'submitted', 'submittedAt', 'updatedAt', 'expireAt']) &&
             d.uid == request.auth.uid && d.group is string && d.group.matches('^[0-9]{1,2}-[0-9]{1,2}-[0-9]{4}$') && rid == d.group + '~' + request.auth.uid &&
             d.jo is int && shortStr(d.exp, 60) && shortStr(d.device, 20) &&
             d.sections is map && d.sections.size() <= 12 && d.external is map && d.external.size() <= 3 &&
             d.submitted is bool && d.updatedAt == request.time && okExpire(d);
    }
    match /labClasses/{space}/reports/{rid} {
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || classOwner(space) == request.auth.uid);
      allow create: if signedIn() && exists(/databases/$(database)/documents/labClasses/$(space)) && okReport(request.resource.data, rid);
      allow update: if signedIn() && (
        // 학생: 최종 제출 전까지만
        (resource.data.uid == request.auth.uid && resource.data.submitted != true && okReport(request.resource.data, rid)) ||
        // 교사: 제출한 보고서 다시 열기만
        (classOwner(space) == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submitted']) && request.resource.data.submitted == false));
      allow delete: if isOwner(space);
    }
    // 교사 화면 AI 켜짐 신호: 공간을 아는 학생은 읽기, 쓰기는 수업 주인만
    match /labClasses/{space}/aiDesk/{d} {
      allow get: if signedIn();
      allow list, delete: if isOwner(space);
      allow create, update: if isOwner(space) && d == 'status' &&
                            request.resource.data.keys().hasOnly(['on', 'provider', 'model', 'seenAt', 'expireAt']) && request.resource.data.on is bool &&
                            shortStr(request.resource.data.provider, 20) && shortStr(request.resource.data.model, 60) &&
                            request.resource.data.seenAt == request.time && okExpire(request.resource.data);
    }
    // 수업 코드 → 공간 (메인 화면 '학생으로 시작'에서 코드만 넣을 때). 하나씩 읽기만, 찾기 기간 안에만, 목록 불가
    match /labClassCodes/{code} {
      // 찾기 기간(joinUntil, 만든 뒤 2일 또는 주인이 다시 연 뒤 2일)이 지나면 못 읽음: 코드를 훑어 공간 id 를 알아내지 못하게
      allow get: if signedIn() && code.matches('^[0-9]{1,2}-[0-9]{4}$') && resource.data.joinUntil > request.time;
      allow create: if isGoogle() && code.matches('^[0-9]{1,2}-[0-9]{4}$') && request.resource.data.owner == request.auth.uid &&
                    request.resource.data.keys().hasOnly(['space', 'owner', 'joinUntil', 'expireAt']) && okExpire(request.resource.data);
      // 찾기 기간이 끝난 코드는 다른 선생님이 다시 쓸 수 있음
      allow update: if isGoogle() && request.resource.data.owner == request.auth.uid &&
                    (resource.data.owner == request.auth.uid || resource.data.joinUntil < request.time) &&
                    request.resource.data.keys().hasOnly(['space', 'owner', 'joinUntil', 'expireAt']) && okExpire(request.resource.data);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
    // 개발 데이터 (선생님 기기만, docs/dev-data.md). GitHub Actions 는 서비스 계정으로 읽음
    match /devlog/{doc} {
      allow read: if isGoogle() && isTeacher(request);
      allow create, update: if isGoogle() && isTeacher(request) && request.resource.data.owner == request.auth.uid &&
                            shortStr(request.resource.data.data, 270000) && okExpire(request.resource.data);
    }

    // Roles collection (read-only for clients, managed by Admin SDK)
    match /roles/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
